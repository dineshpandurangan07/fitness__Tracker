# =========================================
#  Fitness Tracker - Backend Env Template
#  Copy to .env and fill in real values.
# =========================================

# MongoDB connection URI (MongoDB Atlas recommended for production)
MONGO_URI=mongodb://127.0.0.1:27017/fitness_tracker

# JWT secret used to sign/verify auth tokens (use a long random string)
JWT_SECRET=supersecret_fitness_jwt_key_99928172!

# Local development port
PORT=5000

# NODE_ENV -> development | production
NODE_ENV=development