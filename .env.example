# =========================================
#  Fitness Tracker - Deployment Variables
# =========================================

# Backend (set these in your hosting provider dashboard)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitness_tracker
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=production

# Frontend (only needed if the API is hosted on a different domain)
VITE_API_URL=/api